<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
  <!-- Three elliptical electron orbits at 0/60/120, like SF Symbols "atom". -->
  <group android:rotation="0" android:pivotX="12" android:pivotY="12">
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.4"
        android:pathData="M1.5,12 a10.5,4 0 1,0 21,0 a10.5,4 0 1,0 -21,0" />
  </group>
  <group android:rotation="60" android:pivotX="12" android:pivotY="12">
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.4"
        android:pathData="M1.5,12 a10.5,4 0 1,0 21,0 a10.5,4 0 1,0 -21,0" />
  </group>
  <group android:rotation="120" android:pivotX="12" android:pivotY="12">
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.4"
        android:pathData="M1.5,12 a10.5,4 0 1,0 21,0 a10.5,4 0 1,0 -21,0" />
  </group>
  <!-- Nucleus -->
  <path
      android:fillColor="@android:color/white"
      android:pathData="M10,12 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0 Z" />
</vector>
