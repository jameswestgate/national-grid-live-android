# Release signing — COPY this file to `keystore.properties` and fill in your values.
# `keystore.properties` and `*.jks` are gitignored; never commit real secrets.
#
# Create the upload keystore first (you choose the passwords):
#   keytool -genkeypair -v \
#     -keystore upload-keystore.jks \
#     -storetype JKS \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -alias upload
#
# Then point storeFile at it (path relative to the project root, or absolute).

storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
